{
  "name": "token-lens",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "frontend:dev": "vite",
    "frontend:build": "vite build",
    "test:frontend": "node --test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:live": "cargo test --manifest-path src-tauri/Cargo.toml live_tokscale_smoke -- --ignored",
    "test": "npm run test:frontend && npm run test:rust",
    "check": "npm run frontend:build && npm run test && cargo fmt --manifest-path src-tauri/Cargo.toml --check"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "tokscale": "4.15.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "vite": "8.2.2"
  }
}
