{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Token Lens",
  "version": "2.0.0-alpha.0",
  "identifier": "com.teeeeooo.tokenlens",
  "build": {
    "beforeDevCommand": "npm run frontend:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run frontend:build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Token Lens",
        "width": 340,
        "height": 650,
        "minWidth": 240,
        "minHeight": 140,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
